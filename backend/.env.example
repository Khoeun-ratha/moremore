# Copy to .env and fill in real values. Never commit .env.

# MySQL connection
DATABASE_URL=mysql+pymysql://learning_user:learning_pass@localhost:3306/learning_platform
TEST_DATABASE_URL=mysql+pymysql://learning_user:learning_pass@localhost:3306/learning_platform_test

# JWT
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=45
REFRESH_TOKEN_EXPIRE_DAYS=14
ALGORITHM=HS256

# CORS - comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# File uploads
MEDIA_ROOT=media
MAX_UPLOAD_SIZE_MB=500

# First admin bootstrap (optional convenience seed, see app/core/bootstrap.py)
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=change-this-password

# Password reset OTP. Leave SMS_WEBHOOK_URL blank to just log the reset code
# server-side instead of texting it (fine for local/dev use).
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=10
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
